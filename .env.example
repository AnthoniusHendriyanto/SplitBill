PORT=8080

# --- Database ---
# DATABASE_URL, when set, is used verbatim and overrides every DB_* field below.
# Leave it unset for local PostgreSQL. For this project copy the URI from
# Supabase Dashboard -> Settings -> Database -> Connection string; only the
# password is missing from the example below. Region: ap-northeast-1.
# Use the SESSION pooler (port 5432). The transaction pooler (6543) breaks the
# repository layer, which holds transactions across multiple statements.
# DATABASE_URL=postgres://postgres.bleozpmdmaetqsgftwiw:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Local fallback. Assemble the DSN from these parts when DATABASE_URL is unset.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=splitmate
DB_SSLMODE=disable
# Hosted projects cap total connections (~15 on free tier). One backend instance
# on Supabase: DB_MAX_CONNS=5 and DB_MIN_CONNS=1 (this project, ap-northeast-1).
DB_MAX_CONNS=25
DB_MIN_CONNS=5
JWT_SECRET=replace-with-a-strong-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-secret
JWT_EXPIRATION=15
REFRESH_TOKEN_EXPIRY=7
FRONTEND_URL=http://localhost:5173
SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=180
SERVER_IDLE_TIMEOUT=120
GROQ_API_KEY=
# Vision model for OCR. Llama-4 Scout/Maverick are gone from Groq (404), so the default
# is the catalog's working vision model. Change here if your key exposes a different one.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
PREMIUM_CALLBACK_SECRET=
# Optional assignment email delivery via Resend. Jobs stay queued until configured.
RESEND_API_KEY=
EMAIL_FROM=
